{
  "schemaVersion": 1,
  "id": "ruffyclient",
  "version": "${version}",
  "name": "Ruffy Visuals",
  "description": "A clean modern Crimson client with a redesigned transparent telemetry HUD, adjustable HUD scale, ten palettes and custom 3D effects.",
  "authors": ["Ruffy"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["de.ruffy.client.RuffyClient"]
  },
  "mixins": [
    "ruffyclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
